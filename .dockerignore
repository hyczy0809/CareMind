# Keep the Docker build context small — never ship the 3+ GB on-device model
# into the image. Hosting the file should be done with a volume mount or an
# external object store.
.git
.venv
__pycache__
*.pyc
*.pyo
node_modules
frontend/node_modules
frontend/.expo
frontend/android/build
frontend/android/app/build
frontend/ios/Pods
uploads
md
*.log
*.task
*.litertlm
models/
.env
